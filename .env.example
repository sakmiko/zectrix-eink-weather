# ============================================================================
# ZECTRIX NOTE4 墨水屏气象站 (V3 免 Key 多源网页聚合 & 区县经纬度精确定位版)
# 将本文件复制为 `.env` 即可自动加载，或通过 `--env <path>` 指定配置文件
# ============================================================================

# --- 1. ZECTRIX 硬件与上屏通道配置 ---
ZECTRIX_API_KEY=your_zectrix_cloud_api_key_here
# ZECTRIX_API_KEY_FILE=/etc/zectrix/api.key
ZECTRIX_API_BASE=https://cloud.zectrix.com
ZECTRIX_DEVICE_ID=AA:BB:CC:DD:EE:FF
ZECTRIX_PAGE_ID=2
# 保护页面列表（逗号分隔，默认保护已被 Codex 额度雷达占用的第 3 页）
ZECTRIX_RESERVED_PAGES=3
ZECTRIX_ALLOW_RESERVED_OVERRIDE=false
ZECTRIX_DITHER=false
ZECTRIX_HTTP_TIMEOUT_SECS=30

# --- 2. 地区与经纬度智能定位配置（支持城市+区县、独立区县/商圈别名、直接经纬度） ---
# 方式 A：一行式智能解析（支持 "北京海淀"、"上海·徐汇区"、"深圳南山区"、"中关村"、"陆家嘴" 或 "116.2980,39.9599"）
WEATHER_LOCATION=北京·海淀区

# 方式 B：分项指定城市、区县与精确经纬度（若设置 WEATHER_LON/LAT 将自动通过 Haversine 球面距离匹配最近区县站号并保留精确坐标）
WEATHER_CITY=北京
WEATHER_DISTRICT=海淀区
# WEATHER_LON=116.2980
# WEATHER_LAT=39.9599
WEATHER_TZ_OFFSET_HOURS=8

# 外挂快速地址簿 JSON 文件路径（默认自动加载同级目录下的 weather_locations.json，未找到时使用内置 88 区县库）
WEATHER_LOCATIONS_FILE=weather_locations.json

# --- 3. 多天气源聚合与免 Key 网页解析配置（默认开箱即用，无需任何 API Key） ---
# 可选模式：
#   aggregate  (默认推荐：并发聚合所有可用免 Key 网页/接口源并做中位数融合)
#   auto       (按 WEATHER_FALLBACK_ORDER 顺序依次尝试，首个成功即返回)
#   nmc        (仅使用中央气象台直连 JSON + 预报网页 HTML 解析)
#   weathercn  (仅使用中国天气网 weather.com.cn 1d/7d 网页与 sk_2d 实况脚本解析)
#   moji_web   (仅使用墨迹天气网页版 tianqi.moji.com 实况/预警/多日 HTML 解析)
#   open_meteo (仅使用 Open-Meteo 经纬度免 Key 网格 API，含 15 分钟级降水雷达)
WEATHER_PROVIDER=aggregate

# 多源融合与自动容灾列表（前 4 项全部免 Key 即开即用，后 3 项配置 Key 后自动加入聚合）
WEATHER_AGGREGATE_SOURCES=nmc,weathercn,moji_web,open_meteo,caiyun,qweather,moji
WEATHER_FALLBACK_ORDER=nmc,weathercn,moji_web,open_meteo,caiyun,qweather,moji
WEATHER_HTTP_TIMEOUT_SECS=15

# --- 4. 免 Key 官方直连与网页解析源参数（默认已按地址簿自动匹配，无需手动修改） ---
NMC_API_BASE=http://www.nmc.cn
# NMC_STATION_ID=54511
# NMC_FORECAST_PATH=ABJ/beijing
# WEATHER_CN_CODE=101010200
# MOJI_WEB_SLUG=beijing/haidian-district
OPEN_METEO_API_BASE=https://api.open-meteo.com

# --- 5. 可选商业 API 增强源（留空则完全跳过，配置后自动参与多源融合） ---
CAIYUN_TOKEN=
QWEATHER_KEY=
QWEATHER_HOST=https://devapi.qweather.com
MOJI_APPCODE=

# --- 6. 墨水屏画廊卡片 UI 排版参数（顶栏已默认移除数据来源标签） ---
WEATHER_HEADER_BADGE=气象站
WEATHER_TREND_BADGE=24H
WEATHER_TREND_TITLE=趋势
WEATHER_LABEL_FEELS=体感
WEATHER_LABEL_HUMIDITY=湿度
WEATHER_LABEL_AQI=空气
WEATHER_MARGIN_PX=4
WEATHER_CARD_BORDER_PX=2
WEATHER_CARD_SHADOW_PX=2
WEATHER_HERO_TEMP_SHADOW=true
WEATHER_INVERT_MASTHEAD=true
WEATHER_INVERT_TODAY_HEADER=true
WEATHER_FORECAST_DAYS=4
WEATHER_HOURLY_POINTS=5
WEATHER_HOURLY_STEP_HOURS=4

# --- 7. 守护进程与本地 HTTP 控制端 ---
WEATHER_REFRESH_SECONDS=1800
WEATHER_RETRY_SECONDS=60
WEATHER_PAUSE_WINDOWS=00:00-06:00
WEATHER_MAX_FAIL_STREAK=5
WEATHER_CONTROL_LISTEN=127.0.0.1:9597
WEATHER_PREVIEW_PATH=weather_preview.png
